{
  "name": "caretlex",
  "version": "0.1.0",
  "private": true,
  "desktopName": "CaretLex",
  "description": "English Markdown reader with document-local vocabulary notes",
  "homepage": "https://example.invalid/caretlex",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "dist:linux": "npm run build && electron-builder --linux AppImage deb --x64 --publish never",
    "dist:appimage": "npm run build && electron-builder --linux AppImage --x64 --publish never",
    "dist:deb": "npm run build && electron-builder --linux deb --x64 --publish never"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.18.6",
    "@codemirror/commands": "^6.8.1",
    "@codemirror/lang-markdown": "^6.3.2",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.38.6",
    "@vueuse/core": "^13.9.0",
    "decode-named-character-reference": "^1.2.0",
    "micromark-util-decode-string": "^2.0.1",
    "pinia": "^3.0.3",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "shiki": "^3.23.0",
    "unified": "^11.0.5",
    "vue": "^3.5.22"
  },
  "devDependencies": {
    "@types/mdast": "^4.0.4",
    "@types/node": "^22.18.12",
    "@vitejs/plugin-vue": "^6.0.1",
    "electron": "44.4.4",
    "electron-builder": "26.16.1",
    "electron-vite": "5.0.0",
    "typescript": "^5.9.3",
    "undici": "7.29.1",
    "vite": "^7.1.12",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.1.0"
  },
  "build": {
    "appId": "dev.caretlex.desktop",
    "productName": "CaretLex",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "linux": {
      "target": [
        { "target": "AppImage", "arch": ["x64"] },
        { "target": "deb", "arch": ["x64"] }
      ],
      "category": "Office",
      "syncDesktopName": true,
      "icon": "branding/app-icon.png",
      "synopsis": "An English Markdown reader with vocabulary notes",
      "artifactName": "CaretLex-${version}-${arch}.${ext}",
      "mimeTypes": ["text/markdown", "text/x-markdown"]
    },
    "deb": {
      "maintainer": "CaretLex Placeholder <maintainer@example.invalid>",
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0",
        "libx11-xcb1",
        "libxcb-dri3-0"
      ]
    },
    "appImage": {
      "compression": "zstd"
    },
    "toolsets": {
      "appimage": "1.0.3"
    }
  }
}
